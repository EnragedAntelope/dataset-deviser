{
  "1": {"class_type": "LoadImage", "_meta": {"title": "Reference 1 (sets output aspect)"},
        "inputs": {"image": "__SOURCE__"}},
  "2": {"class_type": "UNETLoader", "_meta": {"title": "Fibo 2.0 Edit Turbo"},
        "inputs": {"unet_name": "fibo2_edit_turbo_bf16.safetensors", "weight_dtype": "default"}},
  "3": {"class_type": "CLIPLoader", "_meta": {"title": "Qwen3-VL 4B (fibo2)"},
        "inputs": {"clip_name": "qwen3vl_4b_bf16.safetensors", "type": "fibo2", "device": "default"}},
  "4": {"class_type": "VAELoader", "_meta": {"title": "FLUX.2 VAE"},
        "inputs": {"vae_name": "flux2-vae.safetensors"}},
  "5": {"class_type": "TextEncodeFibo2", "_meta": {"title": "Prompt + references"},
        "inputs": {"prompt": "__PROMPT__", "negative_prompt": "", "batch_size": 1,
                   "width": ["13", 1], "height": ["14", 1],
                   "clip": ["3", 0], "vae": ["4", 0], "images.image_1": ["1", 0]}},
  "6": {"class_type": "KSampler", "_meta": {"title": "Sampler (seed)"},
        "inputs": {"seed": 0, "steps": 8, "cfg": 1, "sampler_name": "euler", "scheduler": "simple",
                   "denoise": 1, "model": ["9", 0], "positive": ["5", 0], "negative": ["5", 1],
                   "latent_image": ["5", 2]}},
  "7": {"class_type": "VAEDecode", "inputs": {"samples": ["6", 0], "vae": ["4", 0]}},
  "8": {"class_type": "SaveImage", "inputs": {"filename_prefix": "LDS", "images": ["7", 0]}},
  "9": {"class_type": "ScaleROPE", "_meta": {"title": "ScaleROPE (stops repeated people above 1 MP)"},
        "inputs": {"model": ["11", 0], "scale_x": ["15", 0], "shift_x": 0, "scale_y": ["15", 0],
                   "shift_y": 0, "scale_t": 1, "shift_t": 0}},
  "10": {"class_type": "PrimitiveFloat", "_meta": {"title": "Output megapixels"},
         "inputs": {"value": 4.0}},
  "11": {"class_type": "ModelAttentionBackend", "_meta": {"title": "Attention (the engine picks INT8 on CUDA)"},
         "inputs": {"model": ["2", 0], "attention": "pytorch attention"}},
  "12": {"class_type": "GetImageSize", "inputs": {"image": ["1", 0]}},
  "13": {"class_type": "ComfyMathExpression", "_meta": {"title": "Output width"},
         "inputs": {"expression": "round(a * (c * 1048576 / (a * b)) ** 0.5 / 16) * 16",
                    "values.a": ["12", 0], "values.b": ["12", 1], "values.c": ["10", 0]}},
  "14": {"class_type": "ComfyMathExpression", "_meta": {"title": "Output height"},
         "inputs": {"expression": "round(b * (c * 1048576 / (a * b)) ** 0.5 / 16) * 16",
                    "values.a": ["12", 0], "values.b": ["12", 1], "values.c": ["10", 0]}},
  "15": {"class_type": "ComfyMathExpression", "_meta": {"title": "RoPE scale = sqrt(1 / MP)"},
         "inputs": {"expression": "(1 / a) ** 0.5", "values.a": ["10", 0]}}
}
